XAI_API_KEY=tu_clave_de_xai
XAI_MODEL=grok-4.7
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash

SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# 1 = avisar por correo a suscriptores en cada cambio de estado
EMAIL_SUB_AUTO=1

# PostgreSQL (local o Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=user
POSTGRES_DB=semaforo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:user@localhost:5432/semaforo

# Bridge Arduino USB
SERIAL_PORT=COM3
SERIAL_BAUD=115200
API_BASE_URL=http://localhost:8000
DEVICE_ID=arduino-uno

# Bot horarios pico — pega aquí la web pública real a scrapear (ATU / gob.pe)
# Ejemplo recomendado (comunicado ATU con horas punta del Metro):
BOLETIN_TRANSITO_URL=https://www.gob.pe/institucion/atu/noticias/777727-comunicado
# Si está vacío, usa el boletín local: http://localhost:8000/boletin/transito
API_PUBLIC_URL=http://localhost:8000
BOT_HORARIOS_INTERVALO_SEG=300
# Política cuando detecta hora punta (segundos)
BOT_PICO_DURACION_ROJO=45
BOT_PICO_DURACION_COOLDOWN=180
BOT_BASE_DURACION_ROJO=60
BOT_BASE_DURACION_COOLDOWN=120
